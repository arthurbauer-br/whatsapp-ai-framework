# Variables for docker-compose.example.yml. Copy to ".env", next to the
# docker-compose.yml, and fill in. Running with "npm start" instead of Docker?
# Use app/.env.example.
#
# Never commit the real .env - it is already in .gitignore.

# --- Proxy (required) -----------------------------------------------------
# HTTP proxy for all WhatsApp traffic - ideally with a residential IP. Any
# provider or self-hosted proxy works, as long as it speaks HTTP (CONNECT).
# SOCKS is not supported. Credentials go in the URL.
# Empty = the bot refuses to start (fail-closed).
# Examples:
#   http://user:password@proxy.example.com:8080
#   http://my-proxy-container:8888     (a container on the same network)
P2SPEED_PROXY=

# --- n8n -----------------------------------------------------------------
# Shared secret of POST /api/send (n8n -> bot). Empty = route disabled.
# Generate with:  openssl rand -hex 32
N8N_TOKEN=

# Webhook the bot forwards incoming messages to. Optional: it can also be set
# from the admin panel, which saves it in app/settings.json.
# Example: http://n8n:5678/webhook/whatsapp
N8N_WEBHOOK_URL=

# Only if you run the n8n service from the compose file. Generate once with
# "openssl rand -hex 24" and keep it: changing it locks n8n out of the
# credentials it already saved.
N8N_ENCRYPTION_KEY=

# --- Optional --------------------------------------------------------------
# Bearer token for the /api routes. Empty = no password (the port is bound to
# 127.0.0.1 in the compose file, so it is not reachable from outside anyway).
ADMIN_PASSWORD=

# Reply sent when no n8n webhook is configured. Empty = stay silent.
DEFAULT_REPLY=

# Baileys log level: silent, error (default), warn. Avoid info/debug - they
# can leak sensitive data into the logs again.
BAILEYS_LOG=error

# Max "is this number on WhatsApp?" checks per hour. Bulk checking is a
# classic ban trigger, so keep it low.
VERIFICA_MAX_HORA=40

# The anti-ban delays depend on the local hour.
TZ=America/Sao_Paulo
