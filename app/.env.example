# WhatsApp AI Bot Configuration

# Server port
PORT=3000

# n8n webhook URL (required for AI responses)
# Example: http://localhost:5678/webhook/whatsapp
# Example: https://your-n8n.com/webhook/whatsapp
N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL_HERE

# Optional: Admin password for web UI
# Leave empty to disable password protection
ADMIN_PASSWORD=

# Outbound HTTP proxy for the WhatsApp connection (residential egress).
# Baileys ignores HTTP_PROXY/HTTPS_PROXY, so this variable is read explicitly.
# Leave empty to connect directly (NOT recommended on a VPS - datacenter IPs get banned).
# Example: http://p2speed-egress:8888
P2SPEED_PROXY=
