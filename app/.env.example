# WhatsApp AI Bot - configuration for running with "npm start".
# Copy to app/.env and fill in. Running with Docker? Use the .env.example at
# the root of the repository, next to docker-compose.example.yml.

# Server port
PORT=3000

# n8n webhook URL (required for AI responses). Can also be set from the admin
# panel, which saves it in settings.json and takes precedence over this.
# Example: http://localhost:5678/webhook/whatsapp
# Example: https://your-n8n.com/webhook/whatsapp
N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL_HERE

# Optional: Admin password for web UI
# Leave empty to disable password protection
ADMIN_PASSWORD=

# REQUIRED: outbound HTTP proxy for the WhatsApp connection (residential egress).
# Baileys ignores HTTP_PROXY/HTTPS_PROXY, so this variable is read explicitly.
# Fail-closed: if this is empty the server refuses to start, so WhatsApp can
# never connect from the datacenter IP.
# Any HTTP proxy works (SOCKS is not supported); credentials go in the URL.
# Example: http://user:password@proxy.example.com:8080
P2SPEED_PROXY=

# Token for POST /api/send (used by n8n to trigger outbound notices).
# Use the SAME value as N8N_TOKEN wherever the caller is configured.
# Leave empty to keep the send route disabled.
N8N_TOKEN=

# Optional: reply sent when no n8n webhook is configured.
# Empty = stay silent (nothing is sent to the contact).
DEFAULT_REPLY=

# Baileys log level: silent, error (default), warn.
# Avoid info/debug - they can leak sensitive data into the logs.
BAILEYS_LOG=error

# Max "is this number on WhatsApp?" checks per hour (POST /api/verificar).
VERIFICA_MAX_HORA=40

# The anti-ban delays depend on the local hour. Set TZ in the shell (or in the
# process manager) if this machine is not on your timezone.

# Anti-ban limits are NOT set here. Both budgets - replies and outbound - live
# in settings.json and are edited from the admin panel, so they survive a
# restart and don't need a redeploy to change.
